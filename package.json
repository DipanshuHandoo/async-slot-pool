{
  "name": "@dipanshuhandoo/async-slot-pool",
  "version": "1.0.1",
  "description": "Dependency-free async task pool with bounded concurrency, retries, timeouts, lazy iterable input, and progress callbacks.",
  "license": "MIT",
  "author": "DipanshuHandoo",
  "keywords": [
    "async",
    "concurrency",
    "task-pool",
    "worker-pool",
    "retry",
    "timeout",
    "iterable"
  ],
  "homepage": "https://github.com/DipanshuHandoo/worker_pool#readme",
  "bugs": {
    "url": "https://github.com/DipanshuHandoo/worker_pool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DipanshuHandoo/worker_pool.git"
  },
  "type": "module",
  "main": "./dist/workerPool.cjs",
  "module": "./dist/workerPool.js",
  "types": "./dist/workerPool.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/workerPool.d.ts",
        "default": "./dist/workerPool.js"
      },
      "require": {
        "types": "./dist/workerPool.d.cts",
        "default": "./dist/workerPool.cjs"
      }
    },
    "./min": {
      "import": {
        "types": "./dist/workerPool.d.ts",
        "default": "./dist/workerPool.min.js"
      },
      "require": {
        "types": "./dist/workerPool.d.cts",
        "default": "./dist/workerPool.min.cjs"
      }
    },
    "./dist/workerPool.global.js": "./dist/workerPool.global.js",
    "./dist/workerPool.global.min.js": "./dist/workerPool.global.min.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/workerPool.global.min.js",
  "jsdelivr": "./dist/workerPool.global.min.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/workerPool.test.js",
    "examples": "node scripts/run-examples.mjs",
    "test:types": "npm run build && tsc --noEmit --strict --module nodenext --target es2022 test/types/consumer.mts test/types/consumer.cts",
    "test:package": "node scripts/check-package.mjs",
    "verify": "node scripts/verify.mjs",
    "pack:check": "node scripts/check-package.mjs --list",
    "publish:dry": "npm publish --dry-run --access public --registry https://registry.npmjs.org/",
    "publish:public": "npm publish --access public --registry https://registry.npmjs.org/",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
